/* ========================================
   ARAMB VENTURES — MAIN STYLES
======================================== */

:root {
  --bg: #f4f2ed;
  --dark: #111111;
  --muted: #6c6a64;
  --line: #d7d4cc;
  --accent: #c95f3d;
  --white: #ffffff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "DM Sans", sans-serif;
  background: var(--bg);
  color: var(--dark);
  line-height: 1.6;
}

h1,
h2,
h3 {
  font-family: "Manrope", sans-serif;
  line-height: 1.08;
  letter-spacing: -0.04em;
}

a {
  color: inherit;
  text-decoration: none;
}

.section {
  padding: 130px 7vw;
}

.section-label {
  font-size: 11px;
  letter-spacing: 0.16em;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 60px;
}


/* ========================================
   NAVIGATION
======================================== */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 78px;
  padding: 0 7vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(244, 242, 237, 0.94);
  backdrop-filter: blur(12px);
  z-index: 1000;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.logo {
  font-family: "Manrope", sans-serif;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.06em;
}

.logo span {
  color: var(--accent);
}

.nav-links {
  display: flex;
  gap: 32px;
  font-size: 13px;
  font-weight: 500;
}

.nav-links a:hover,
.footer-links a:hover {
  color: var(--accent);
}

.nav-cta {
  font-size: 13px;
  font-weight: 600;
  border-bottom: 1px solid var(--dark);
  padding-bottom: 3px;
}

.menu-toggle {
  display: none;
  border: none;
  background: none;
  font-size: 24px;
  cursor: pointer;
}


/* ========================================
   HERO
======================================== */

.hero {
  min-height: 100vh;
  padding: 170px 7vw 100px;
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 80px;
  align-items: end;
}

.eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 28px;
}

.hero h1 {
  font-size: clamp(58px, 8vw, 120px);
  max-width: 1000px;
}

.hero h1 em {
  font-style: normal;
  color: var(--accent);
}

.hero-text {
  max-width: 600px;
  margin-top: 45px;
  font-size: 19px;
  line-height: 1.6;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  gap: 15px;
  margin-top: 40px;
  flex-wrap: wrap;
}

.button {
  display: inline-block;
  padding: 15px 23px;
  font-size: 13px;
  font-weight: 600;
  transition: 0.25s ease;
}

.button-primary {
  background: var(--dark);
  color: var(--white);
}

.button-primary:hover {
  background: var(--accent);
}

.button-secondary {
  border: 1px solid var(--dark);
}

.button-secondary:hover {
  background: var(--dark);
  color: var(--white);
}

.hero-side {
  padding-bottom: 10px;
}

.hero-line {
  height: 1px;
  width: 100%;
  background: var(--dark);
  margin-bottom: 25px;
}

.hero-side p {
  font-size: 14px;
  color: var(--muted);
}


/* ========================================
   INTRO
======================================== */

.intro {
  border-top: 1px solid var(--line);
}

.intro-content {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 10vw;
}

.intro h2 {
  font-size: clamp(48px, 6vw, 85px);
}

.intro-content > div {
  max-width: 650px;
}

.large-text {
  font-size: 25px;
  line-height: 1.45;
  margin-bottom: 35px;
}

.intro p:not(.large-text) {
  color: var(--muted);
  margin-bottom: 25px;
}

.closing-line {
  color: var(--dark) !important;
  font-weight: 600;
  font-size: 18px;
}


/* ========================================
   SERVICES
======================================== */

.services {
  background: var(--dark);
  color: var(--white);
}

.services .section-label {
  color: #99958d;
}

.section-heading {
  display: grid;
  grid-template-columns: 1fr 0.7fr;
  gap: 10vw;
  margin-bottom: 90px;
}

.section-heading h2 {
  font-size: clamp(48px, 6vw, 80px);
}

.section-heading p {
  color: #aaa7a0;
  font-size: 17px;
  align-self: end;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid #3a3936;
}

.service-card {
  padding: 45px 35px 30px 0;
  border-right: 1px solid #3a3936;
}

.service-card:not(:first-child) {
  padding-left: 35px;
}

.service-card:last-child {
  border-right: none;
}

.service-number {
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
}

.service-card h3 {
  font-size: 30px;
  margin: 55px 0 35px;
}

.service-card p {
  color: #aaa7a0;
  font-size: 14px;
  margin-bottom: 20px;
}


/* ========================================
   COMPANIES
======================================== */

.companies {
  border-bottom: 1px solid var(--line);
}

.companies-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10vw;
}

.companies h2 {
  font-size: clamp(48px, 6vw, 80px);
}

.company-list {
  border-top: 1px solid var(--line);
  margin-top: 60px;
}

.company-list div {
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  font-size: 16px;
  font-weight: 600;
}

.company-list span {
  color: var(--accent);
}


/* ========================================
   WHY ARAMB
======================================== */

.why {
  background: #dedbd3;
}

.why-top {
  max-width: 1100px;
}

.why-top h2 {
  font-size: clamp(48px, 6.5vw, 95px);
}

.why-bottom {
  margin-top: 120px;
  padding-top: 40px;
  border-top: 1px solid #aaa79f;
  display: grid;
  grid-template-columns: 0.7fr 0.7fr 1.3fr;
  gap: 60px;
}

.stat strong {
  display: block;
  font-family: "Manrope", sans-serif;
  font-size: 70px;
  letter-spacing: -0.06em;
}

.stat span {
  color: var(--muted);
  font-size: 14px;
}

.why-copy p {
  color: #55534e;
  margin-bottom: 25px;
}


/* ========================================
   JOURNEY
======================================== */

.journey-heading {
  display: grid;
  grid-template-columns: 1fr 0.6fr;
  gap: 10vw;
  margin-bottom: 80px;
}

.journey-heading h2 {
  font-size: clamp(48px, 6vw, 80px);
}

.journey-heading p {
  color: var(--muted);
  align-self: end;
}

.journey-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--line);
}

.journey-card {
  padding: 40px 30px 0 0;
  border-right: 1px solid var(--line);
}

.journey-card:not(:first-child) {
  padding-left: 30px;
}

.journey-card:last-child {
  border-right: none;
}

.journey-card span {
  color: var(--accent);
  font-weight: 700;
  font-size: 12px;
}

.journey-card h3 {
  font-size: 28px;
  margin: 45px 0 20px;
}

.journey-card p {
  color: var(--muted);
  font-size: 14px;
}


/* ========================================
   CONTACT
======================================== */

.contact {
  background: var(--dark);
  color: var(--white);
  text-align: center;
  padding: 170px 7vw;
}

.contact-content {
  max-width: 800px;
  margin: auto;
}

.contact .eyebrow {
  color: var(--accent);
}

.contact h2 {
  font-size: clamp(60px, 8vw, 110px);
}

.contact p {
  max-width: 500px;
  margin: 35px auto 45px;
  color: #aaa7a0;
  font-size: 17px;
}

.contact .button-primary {
  background: var(--white);
  color: var(--dark);
}

.contact .button-primary:hover {
  background: var(--accent);
  color: var(--white);
}


/* ========================================
   FOOTER
======================================== */

.footer {
  background: var(--dark);
  color: var(--white);
  padding: 60px 7vw 30px;
  border-top: 1px solid #3a3936;
}

.footer-brand p {
  color: #88857f;
  margin-top: 10px;
  font-size: 13px;
}

.footer-links {
  display: flex;
  gap: 30px;
  margin-top: 50px;
  font-size: 13px;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  padding-top: 60px;
  margin-top: 60px;
  border-top: 1px solid #3a3936;
  color: #77746e;
  font-size: 11px;
}


/* ========================================
   MOBILE
======================================== */

@media (max-width: 900px) {

  .nav-links,
  .nav-cta {
    display: none;
  }

  .menu-toggle {
    display: block;
    color: var(--dark);
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 140px;
  }

  .hero-side {
    max-width: 350px;
  }

  .intro-content,
  .section-heading,
  .companies-layout,
  .journey-heading {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .service-grid,
  .journey-grid {
    grid-template-columns: 1fr;
  }

  .service-card,
  .service-card:not(:first-child),
  .journey-card,
  .journey-card:not(:first-child) {
    padding: 40px 0;
    border-right: none;
    border-bottom: 1px solid #3a3936;
  }

  .journey-card {
    border-color: var(--line) !important;
  }

  .why-bottom {
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 80px;
  }

  .footer-bottom {
    flex-direction: column;
    gap: 10px;
  }

}

@media (max-width: 600px) {

  .section {
    padding: 90px 6vw;
  }

  .navbar {
    padding: 0 6vw;
  }

  .hero {
    padding-left: 6vw;
    padding-right: 6vw;
  }

  .hero h1 {
    font-size: 55px;
  }

  .hero-text {
    font-size: 17px;
  }

  .large-text {
    font-size: 21px;
  }

  .contact {
    padding: 110px 6vw;
  }

  .footer {
    padding-left: 6vw;
    padding-right: 6vw;
  }

  .footer-links {
    flex-wrap: wrap;
  }

}
